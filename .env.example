# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. For local dev, docker-compose provides this.
DATABASE_URL=postgresql+asyncpg://reviewpulse:reviewpulse@localhost:5432/reviewpulse

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_KEY=<service-role-key>
# JWT secret: Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=<jwt-secret>
# Local/dev registration uses the server-only service key to avoid Supabase's
# built-in confirmation email rate limit. Set false to use public signup emails.
USE_SUPABASE_ADMIN_SIGNUP=true

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Which provider handles review analysis: "deepseek" or "anthropic"
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=<your-deepseek-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>   # only needed if LLM_PROVIDER=anthropic

# Embeddings are always routed to DeepSeek (Anthropic has no embedding API).
# deepseek-embedding outputs 1024-dimensional vectors; this must match the
# vector column size in the migration (default: 1024).
EMBEDDING_DIM=1024

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development   # "development" | "production"
SECRET_KEY=change-me-in-production
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# ── Admin ─────────────────────────────────────────────────────────────────────
# Protects the /admin/metrics endpoint — change before deploying
ADMIN_TOKEN=change-me-admin-token
